# ----------------------------------------------------------------------------
# Smart Balance - variaveis de ambiente (modelo para o seu .env)
#
# Copie este arquivo:  cp .env.example .env
# Nunca versione o arquivo .env (ja esta no .gitignore).
#
# Existem dois perfis de execucao:
#   1) Desenvolvimento local (API via venv + PostgreSQL via compose.dev.yml)
#   2) Docker Compose (producao/desploy, compose.yml)
# Os valores padrao deste exemplo sao do perfil 1 (desenvolvimento local).
# ----------------------------------------------------------------------------

# development | production | test (usado como marcador do ambiente atual)
APP_ENV=development

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_DB=Smart-Balance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password

# Desenvolvimento local: localhost
# Docker Compose (compose.yml): db  (nome do servico de banco na rede do compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# URLs de servicos
# ----------------------------------------------------------------------------
# URL base usada para montar links de imagens, QR codes de pareamento, etc.
# Desenvolvimento local: http://localhost:8000
# Producao/rede local:   http://<IP ou dominio da API>:8000
BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Reconhecimento de alimentos (SigLIP via HuggingFace Transformers + PyTorch)
# ----------------------------------------------------------------------------
# Nao existe modelo ONNX neste projeto: a inferencia usa PyTorch em CPU
# (fallback automatico quando nao ha CUDA).

# Identificador do modelo no HuggingFace Hub OU caminho absoluto de uma pasta
# local com o modelo ja baixado. Padrao: google/siglip-base-patch16-224
SIGLIP_MODEL_NAME=google/siglip-base-patch16-224

# Cache do HuggingFace (pesos do modelo). Exportado no shell antes de iniciar
# a API (o run_local.sh exporta as variaveis do .env automaticamente).
# Ex.: /home/<usuario>/.cache/huggingface
#HF_HOME=/home/<usuario>/.cache/huggingface

# Threads do PyTorch na inferencia (opcional; vazio = padrao do PyTorch).
TORCH_NUM_THREADS=
